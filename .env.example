# Copy to .env.production (hosted builds) or .env.local (to try Supabase while developing).
# Both values are public by design: the database is protected by the row-level security in supabase/setup.sql.
# Leave them unset to use the bundled Node server instead (npm run dev / npm start).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
